# Copy to `.env` and adjust for your machine. All values are optional —
# MovieEdit falls back to sensible defaults (bundled ffmpeg-static / ffprobe-static
# and, when set, an existing Chromium) if these are unset.

# HTTP port for the MovieEdit server.
PORT=4000

# Max upload size in bytes. Default 21474836480 (20 GB). Raise for larger sources.
MAX_UPLOAD_BYTES=21474836480

# Chunk size the browser uses when slicing uploads, in bytes. Default 8388608 (8 MB).
UPLOAD_CHUNK_BYTES=8388608

# --- Render engine (HyperFrames) binaries ---------------------------------
# ffmpeg / ffprobe: leave unset to use the bundled ffmpeg-static & ffprobe-static.
# Override only if you want a system build (e.g. hardware-accelerated).
# HYPERFRAMES_FFMPEG_PATH=/usr/bin/ffmpeg
# HYPERFRAMES_FFPROBE_PATH=/usr/bin/ffprobe

# Chromium used by the headless renderer. Point this at any Chrome/Chromium
# binary. Examples:
#   PUPPETEER_EXECUTABLE_PATH=/opt/pw-browsers/chromium   (Playwright-provided)
#   PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome
# If unset, Puppeteer's own downloaded Chromium is used (requires `npx puppeteer browsers install chrome`).
# PUPPETEER_EXECUTABLE_PATH=/opt/pw-browsers/chromium
