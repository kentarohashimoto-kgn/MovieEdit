# Puppeteer (pulled in by @hyperframes/producer) tries to download a Chromium
# build on install. In sandboxed / CI environments that download often fails or
# is unwanted. Skip it and point MovieEdit at an existing Chromium via
# PUPPETEER_EXECUTABLE_PATH (see .env.example / README).
PUPPETEER_SKIP_DOWNLOAD=true

# Be resilient to flaky networks when fetching packages.
fetch-retries=5
fetch-retry-mintimeout=2000
fetch-timeout=120000
