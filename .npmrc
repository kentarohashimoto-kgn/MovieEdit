# On a normal machine, `npm install` auto-downloads Chromium (via puppeteer) and
# ffmpeg (via ffmpeg-static) so rendering works out of the box — nothing extra
# to install.
#
# In a restricted/sandboxed/CI network where those binary downloads are blocked,
# set PUPPETEER_SKIP_DOWNLOAD=true in the environment and point MovieEdit at an
# existing Chromium via PUPPETEER_EXECUTABLE_PATH (see .env.example / README).

# Be resilient to flaky networks when fetching packages.
fetch-retries=5
fetch-retry-mintimeout=2000
fetch-timeout=120000
